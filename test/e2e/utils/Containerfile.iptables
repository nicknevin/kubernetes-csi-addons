# Custom iptables image for CSI-Addons fault injection testing.
# Install all packages here (apk add in build). E2E DaemonSets and connectivity probe Jobs must not run apk/apt at runtime.
FROM alpine:3.19

LABEL org.opencontainers.image.title="CSI-Addons Iptables Manager"
LABEL org.opencontainers.image.description="Pre-built alpine image with iptables and network tools for fault injection testing"
LABEL org.opencontainers.image.source="https://github.com/csi-addons/kubernetes-csi-addons"

# Install iptables (all variants) and comprehensive network debugging tools
RUN apk add --no-cache \
    iptables \
    iptables-legacy \
    ip6tables \
    iproute2 \
    inotify-tools \
    curl \
    wget \
    netcat-openbsd \
    bind-tools \
    iputils \
    tcpdump \
    mtr \
    tini \
    bash \
    coreutils \
    util-linux \
    procps \
    net-tools \
    traceroute \
    nmap \
    iperf3 \
    && rm -rf /var/cache/apk/*

# Verify critical installations and iptables variants
RUN iptables --version && \
    iptables-legacy --version && \
    ip link show && \
    which iptables && \
    which iptables-legacy && \
    which ip && \
    which ping && \
    which traceroute && \
    which netstat && \
    which nc && \
    which nslookup && \
    which tcpdump && \
    which tini

# Create working directories
RUN mkdir -p /rules /tmp /var/log /usr/local/bin

# Copy pre-built fence scripts
COPY scripts/ /usr/local/bin/
RUN chmod +x /usr/local/bin/*.sh

# Create convenience symlinks without .sh extension
RUN ln -s /usr/local/bin/detect-iptables.sh /usr/local/bin/detect-iptables && \
    ln -s /usr/local/bin/fence-ip.sh /usr/local/bin/fence-ip && \
    ln -s /usr/local/bin/unfence-ip.sh /usr/local/bin/unfence-ip && \
    ln -s /usr/local/bin/list-fence-rules.sh /usr/local/bin/list-fence-rules && \
    ln -s /usr/local/bin/emergency-cleanup.sh /usr/local/bin/emergency-cleanup

# Set working directory
WORKDIR /

# Default command for debugging
CMD ["sh", "-c", "echo 'CSI-Addons Iptables Manager Ready'; while true; do sleep 30; done"]