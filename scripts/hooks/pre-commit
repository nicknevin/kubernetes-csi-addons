#!/bin/bash
# Pre-commit hook: Run shellcheck on modified shell scripts
# This catches linting issues before they reach the CI pipeline
#
# Installed via: scripts/setup-hooks.sh
# To bypass: git commit --no-verify

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit shellcheck on shell scripts..."

# Get all staged shell files (.sh extension)
SHELL_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sh$' || true)

if [ -z "$SHELL_FILES" ]; then
    echo "✓ No shell scripts to check"
    exit 0
fi

# Check if shellcheck is installed
if ! command -v shellcheck &>/dev/null; then
    echo -e "${YELLOW}⚠ Warning: shellcheck is not installed. Skipping shell script linting.${NC}"
    echo "  Install with: apt-get install shellcheck (or via your package manager)"
    exit 0
fi

FAILED_FILES=()
PASSED_FILES=()

# Run shellcheck on each shell file
for file in $SHELL_FILES; do
    if [ -f "$REPO_ROOT/$file" ]; then
        echo -n "  Checking $file... "
        if shellcheck "$REPO_ROOT/$file" 2>/dev/null; then
            echo -e "${GREEN}✓${NC}"
            PASSED_FILES+=("$file")
        else
            echo -e "${RED}✗ FAILED${NC}"
            FAILED_FILES+=("$file")
            # Show the actual errors
            shellcheck "$REPO_ROOT/$file" || true
        fi
    fi
done

# Summary
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Shellcheck Summary:"
echo "  ✓ Passed: ${#PASSED_FILES[@]}"
echo "  ✗ Failed: ${#FAILED_FILES[@]}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ ${#FAILED_FILES[@]} -gt 0 ]; then
    echo -e "${RED}❌ Commit blocked: Fix shellcheck errors above and try again${NC}"
    echo ""
    echo "You can bypass this check with: git commit --no-verify"
    echo "But it's recommended to fix the linting issues first."
    exit 1
fi

echo -e "${GREEN}✅ All shell scripts passed linting!${NC}"
exit 0
